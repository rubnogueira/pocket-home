#!/bin/sh
# NativeScript invokes plain `ruby`; route through Bundler so `xcodeproj` resolves from vendor/bundle.
ROOT="$(CDPATH= cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT" || exit 1
if ! command -v bundle >/dev/null 2>&1; then
  echo "pocket-ns: bundler not found — install Ruby and run: gem install bundler" >&2
  exit 127
fi
exec bundle exec ruby "$@"
