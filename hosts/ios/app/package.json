  },
  "devDependencies": {
    "@nativescript/ios-quickjs": "9.1.0-alpha.0",
    "@nativescript/types": "^9.1.1",
    "@nativescript/webpack": "^5.0.38",
    "nativescript": "^9.1.1",
    "typescript": "^7.0.2",
    "typescript-webpack": "npm:typescript@5.9.3"
  },
  "overrides": {
