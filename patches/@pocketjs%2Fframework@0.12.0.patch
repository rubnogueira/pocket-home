+/// Pocket Home: sub-pixel translates (spec draw_op OFFSET). Off by default: every coordinate is
+/// rounded to whole logical px, so a fractional translate (a scroll offset mid-fling) moves in
+/// whole-px steps (3 device px at 3x) and, because boxes and glyph origins round independently,
+/// text can step against its box. When a host that can draw at device-pixel precision opts in
+/// (the browser's WebGL backend), a translate-only node paints its subtree at the whole-px part
+/// of its translate — so the subtree stays pixel-consistent — and wraps it in OFFSET/OFFSET_POP
+/// carrying the fractional part, which the backend applies snapped to device pixels.
+static SUBPIXEL_TRANSLATE: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+pub fn set_subpixel_translate(on: bool) {
+    SUBPIXEL_TRANSLATE.store(on, core::sync::atomic::Ordering::Relaxed);
+}
+
+pub fn subpixel_translate() -> bool {
+    SUBPIXEL_TRANSLATE.load(core::sync::atomic::Ordering::Relaxed)
+}
