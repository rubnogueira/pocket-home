{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun", "node"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "typeRoots": ["node_modules/@types", "app/types"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/types/**/*.d.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "pocket.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".pocket", ".pocketjs-app-check-*", "hosts"]
}
